<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.logistics.api.mapper.UserMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.logistics.api.model.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="role" column="role"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="avatar" column="avatar"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="create_time"/>
        <result property="updatedAt" column="update_time"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, username, password, role, name, phone, email, avatar, status, create_time, update_time
    </sql>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        WHERE id = #{id}
    </select>

    <!-- 根据用户名查询 -->
    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        WHERE username = #{username}
    </select>

    <!-- 检查用户名是否存在 -->
    <select id="existsByUsername" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM users
        WHERE username = #{username}
    </select>

    <!-- 根据手机号查询 -->
    <select id="selectByPhone" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        WHERE phone = #{phone}
        LIMIT 1
    </select>

    <!-- 根据手机号和角色查询 -->
    <select id="selectByPhoneAndRole" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        WHERE phone = #{phone} AND role = #{role}
        LIMIT 1
    </select>

    <!-- 检查手机号和角色是否存在 -->
    <select id="existsByPhoneAndRole" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM users
        WHERE phone = #{phone} AND role = #{role}
    </select>

    <!-- 查询所有用户 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
    </select>

    <select id="countTotalUsers" resultType="long">
        SELECT COUNT(*) FROM users
    </select>

    <select id="countByRoleValue" resultType="long">
        SELECT COUNT(*) FROM users WHERE role = #{role}
    </select>

    <select id="countUsersCreatedOnOrAfter" resultType="long">
        SELECT COUNT(*) FROM users WHERE create_time &gt;= #{fromTime}
    </select>

    <select id="selectByRole" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users WHERE role = #{role}
    </select>

    <select id="selectByRoleAndStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users WHERE role = #{role} AND status = #{status}
        ORDER BY create_time DESC
    </select>

    <select id="countAdminListUsers" resultType="long">
        SELECT COUNT(*) FROM users
        <where>
            role != 'admin'
            <if test="status != null and status != ''">
                <if test="status == 'active'">
                    AND status = 1
                </if>
                <if test="status == 'disabled'">
                    AND status = 0
                </if>
            </if>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%')
                     OR name LIKE CONCAT('%', #{keyword}, '%')
                     OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
        </where>
    </select>

    <select id="selectAdminListUsers" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        <where>
            role != 'admin'
            <if test="status != null and status != ''">
                <if test="status == 'active'">
                    AND status = 1
                </if>
                <if test="status == 'disabled'">
                    AND status = 0
                </if>
            </if>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%')
                     OR name LIKE CONCAT('%', #{keyword}, '%')
                     OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 插入用户 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (
            username, password, role, name, phone, email, avatar, status, create_time, update_time
        ) VALUES (
            #{username}, #{password}, #{role}, #{name}, #{phone}, #{email}, #{avatar}, #{status}, NOW(), NOW()
        )
    </insert>

    <!-- 更新用户 -->
    <update id="updateById">
        UPDATE users
        SET username = #{username},
            password = #{password},
            role = #{role},
            name = #{name},
            phone = #{phone},
            email = #{email},
            avatar = #{avatar},
            status = #{status},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 删除用户 -->
    <delete id="deleteById">
        DELETE FROM users WHERE id = #{id}
    </delete>

    <!-- ============================================ -->
    <!-- 复杂查询示例（可按需扩展） -->
    <!-- ============================================ -->

    <!-- 分页查询用户列表 -->
    <select id="selectByPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        <where>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%')
                     OR name LIKE CONCAT('%', #{keyword}, '%')
                     OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 统计用户数量 -->
    <select id="countUsers" resultType="long">
        SELECT COUNT(*)
        FROM users
        <where>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- 批量查询用户 -->
    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 批量更新用户状态 -->
    <update id="batchUpdateStatus">
        UPDATE users
        SET status = #{status},
            update_time = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 根据角色统计 -->
    <select id="countByRole" resultType="java.util.HashMap">
        SELECT role, COUNT(*) as count
        FROM users
        GROUP BY role
    </select>

    <!-- 更新用户状态 -->
    <update id="updateStatus">
        UPDATE users
        SET status = #{status},
            update_time = NOW()
        WHERE id = #{id}
    </update>

</mapper>
