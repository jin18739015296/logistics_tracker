<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.logistics.api.mapper.LogisticsEventMapper">

    <resultMap id="BaseResultMap" type="com.logistics.api.model.LogisticsEvent">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="status" column="status"/>
        <result property="description" column="description"/>
        <result property="location" column="location"/>
        <result property="latitude" column="latitude"/>
        <result property="longitude" column="longitude"/>
        <result property="operatorId" column="operator_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_id, status, description, location, latitude, longitude, operator_id, create_time
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO logistics_events
        (order_id, status, description, location, latitude, longitude, operator_id, create_time)
        VALUES
        (#{orderId}, #{status}, #{description}, #{location}, #{latitude}, #{longitude}, #{operatorId}, #{createTime})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM logistics_events WHERE id = #{id}
    </select>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM logistics_events
        WHERE order_id = #{orderId}
        ORDER BY create_time ASC
    </select>

    <select id="selectByOrderIdAndStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM logistics_events
        WHERE order_id = #{orderId} AND status = #{status}
        LIMIT 1
    </select>

    <select id="selectLatestByOrderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM logistics_events
        WHERE order_id = #{orderId}
        ORDER BY create_time DESC
        LIMIT 1
    </select>

    <select id="selectLastNonExceptionStatusByOrderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM logistics_events
        WHERE order_id = #{orderId}
        AND status != 'exception'
        ORDER BY create_time DESC
        LIMIT 1
    </select>

</mapper>
